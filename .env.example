# Generate using: npm run server -- hash-password
# Single quotes preserve the dollar signs in an Argon2 hash in Docker Compose.
TUINAPP_PASSWORD_HASH='replace-with-generated-argon2-hash'
# Must match the URL you use in your browser, with no trailing slash.
TUINAPP_PUBLIC_ORIGIN=http://127.0.0.1:3000
TUINAPP_BACKUP_INTERVAL_SECONDS=3600

# Optional: change the host port, and update PUBLIC_ORIGIN to match.
TUINAPP_PORT=3000
