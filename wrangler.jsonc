{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tuinapp",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{
    "binding": "DB", "database_name": "tuinapp",
    "database_id": "610e681f-4f5f-45f2-983b-aa11002d294d",
    "migrations_dir": "cloudflare/migrations"
  }],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "tuinapp-backups" }],
  "vars": { "TUINAPP_PUBLIC_ORIGIN": "https://tuin.familiedejong.be" },
  "env": {
    "preview": {
      "d1_databases": [{ "binding": "DB", "database_name": "tuinapp-preview", "database_id": "11111111-1111-1111-1111-111111111111", "migrations_dir": "cloudflare/migrations" }],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "tuinapp-backups-preview" }]
    }
  }
}
